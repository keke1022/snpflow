@@ -1127,6 +1128,101 @@ dma_map_cb(struct rte_mempool *mp __rte_unused, void *opaque __rte_unused,
 }
 #endif
 
+
+/*
+ * 机密虚拟机（SEV-SNP）下的外部内存来源。
+ *
+ * SNP guest 里普通内存与大页都是私有加密页，设备无法 DMA，
+ * 注册阶段返回 EIO。cvm_shared 内核模块提供「已转共享且不经 swiotlb」
+ * 的内存，以 dma-buf 导出。
+ *
+ * 这里是应用侧的用法示范：自己申请、自己登记进 EAL，
+ * 再交给 rte_pktmbuf_pool_create_extbuf()。
+ */
+#define CVM_SHARED_DEV "/dev/cvm_shared"
+
+struct cvm_shared_alloc_req {
+	uint64_t size;
+	uint32_t flags;
+	int32_t fd;
+};
+
+#define CVM_SHARED_IOC_ALLOC _IOWR('C', 0x01, struct cvm_shared_alloc_req)
+
+/* 返回映射地址，失败返回 NULL（表示本机不是机密虚拟机，走原路） */
+static void *
+cvm_shared_get(size_t size)
+{
+	struct cvm_shared_alloc_req req;
+	size_t page_sz = (size_t)sysconf(_SC_PAGESIZE);  /* 应用侧不能用 rte_mem_page_size，非公开 ABI */
+
+	/*
+	 * rte_extmem_register 要求 len 与 va 都按 page_sz 对齐，
+	 * 而 EXTBUF_ZONE_SIZE 是 2MB-256B，故意不对齐。
+	 * 这里向上取整，多出的尾部不会被切成分区，不影响正确性。
+	 */
+	size = RTE_ALIGN_CEIL(size, page_sz);
+	req.size = size;
+	req.flags = 0;
+	req.fd = -1;
+	rte_iova_t *iovas;
+	unsigned int i, n_pages;
+	void *va;
+	int dev;
+
+	dev = open(CVM_SHARED_DEV, O_RDWR);
+	if (dev < 0)
+		return NULL;                    /* 非机密虚拟机 */
+	if (ioctl(dev, CVM_SHARED_IOC_ALLOC, &req) < 0) {
+		TESTPMD_LOG(ERR, "cvm_shared: 申请 %zu 字节失败: %s\n",
+			    size, strerror(errno));
+		close(dev);
+		return NULL;
+	}
+	close(dev);
+
+	va = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, req.fd, 0);
+	if (va == MAP_FAILED) {
+		TESTPMD_LOG(ERR, "cvm_shared: 映射失败: %s\n", strerror(errno));
+		close(req.fd);
+		return NULL;
+	}
+
+	/*
+	 * 登记进 EAL，否则 mlx5 的 mlx5_mr_create() 里
+	 * rte_mem_virt2memseg_list() 查不到这块内存。
+	 * iova_addrs 不能传 NULL（那会置成 RTE_BAD_IOVA），
+	 * 显式填 IOVA == VA，需配合 --iova-mode=va。
+	 */
+	n_pages = size / page_sz;
+	iovas = malloc(sizeof(*iovas) * n_pages);
+	if (iovas == NULL) {
+		munmap(va, size);
+		close(req.fd);
+		return NULL;
+	}
+	for (i = 0; i < n_pages; i++)
+		iovas[i] = (rte_iova_t)(uintptr_t)va + (rte_iova_t)i * page_sz;
+	if (rte_extmem_register(va, size, iovas, n_pages, page_sz) != 0) {
+		TESTPMD_LOG(ERR,
+			    "cvm_shared: rte_extmem_register 失败: %s"
+			    " (va=%p len=%zu page_sz=%zu n_pages=%u)\n",
+			    rte_strerror(rte_errno), va, size, page_sz, n_pages);
+		free(iovas);
+		munmap(va, size);
+		close(req.fd);
+		return NULL;
+	}
+	free(iovas);
+
+	TESTPMD_LOG(INFO,
+		    "cvm_shared: 外部内存就绪 va=%p size=%zu（IOVA=VA）\n",
+		    va, size);
+	/* fd 故意不关：dma-buf 引用计数要等 munmap 之后才归零，
+	 * 但保留 fd 可以让区域在进程生命周期内稳定存在。 */
+	return va;
+}
+
 static unsigned int
 setup_extbuf(uint32_t nb_mbufs, uint16_t mbuf_sz, unsigned int socket_id,
 	    char *pool_name, struct rte_pktmbuf_extmem **ext_mem)
@@ -1134,6 +1230,7 @@ setup_extbuf(uint32_t nb_mbufs, uint16_t mbuf_sz, unsigned int socket_id,
 	struct rte_pktmbuf_extmem *xmem;
 	unsigned int ext_num, zone_num, elt_num;
 	uint16_t elt_size;
+	void *cvm_base;
 
 	elt_size = RTE_ALIGN_CEIL(mbuf_sz, RTE_CACHE_LINE_SIZE);
 	elt_num = EXTBUF_ZONE_SIZE / elt_size;
@@ -1146,6 +1243,29 @@ setup_extbuf(uint32_t nb_mbufs, uint16_t mbuf_sz, unsigned int socket_id,
 		*ext_mem = NULL;
 		return 0;
 	}
+	/*
+	 * 机密虚拟机下改从 cvm_shared 取内存：普通 memzone 背后是私有
+	 * 加密页，设备注册会返回 EIO。一次申请全部分区，避免多次
+	 * extmem_register 产生零碎区间。
+	 */
+	cvm_base = cvm_shared_get((size_t)EXTBUF_ZONE_SIZE * zone_num);
+	if (cvm_base != NULL) {
+		for (ext_num = 0; ext_num < zone_num; ext_num++) {
+			struct rte_pktmbuf_extmem *xseg = xmem + ext_num;
+			void *p = (uint8_t *)cvm_base +
+				  (size_t)EXTBUF_ZONE_SIZE * ext_num;
+
+			xseg->buf_ptr = p;
+			/* IOVA == VA，与共享区的登记方式和 mkey 的
+			 * start_addr 保持一致 */
+			xseg->buf_iova = (rte_iova_t)(uintptr_t)p;
+			xseg->buf_len = EXTBUF_ZONE_SIZE;
+			xseg->elt_size = elt_size;
+		}
+		*ext_mem = xmem;
+		return ext_num;
+	}
+
 	for (ext_num = 0; ext_num < zone_num; ext_num++) {
 		struct rte_pktmbuf_extmem *xseg = xmem + ext_num;
 		const struct rte_memzone *mz;
diff --git a/drivers/common/mlx5/linux/mlx5_cvm_shared.c b/drivers/common/mlx5/linux/mlx5_cvm_shared.c
index fcc38f2..4f34cd6 100644
--- a/drivers/common/mlx5/linux/mlx5_cvm_shared.c
