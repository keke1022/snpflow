 #define CVM_SHARED_IOC_ALLOC \
 	_IOWR(CVM_SHARED_IOC_MAGIC, 0x01, struct cvm_shared_alloc_req)
 
+/*
+ * 按虚拟地址反查归属。存在多方各自申请共享内存的情况
+ * （驱动一块、应用自己一块），任何一方都掌握不了全部区间，
+ * 但内核知道全部映射。返回的 fd 是新的，用完要 close。
+ */
+struct cvm_shared_lookup_req {
+	uint64_t va;
+	int32_t fd;
+	uint32_t pad;
+	uint64_t offset;
+	uint64_t len;
+};
+
+#define CVM_SHARED_IOC_LOOKUP \
+	_IOWR(CVM_SHARED_IOC_MAGIC, 0x04, struct cvm_shared_lookup_req)
+
 /** 默认共享区大小。队列、驱动杂项内存与 mbuf 数据区都从这里出。 */
 #define CVM_DEFAULT_REGION_SIZE (512ull << 20)
 
@@ -307,22 +323,67 @@ mlx5_cvm_shared_contains(const void *addr)
 	uintptr_t a = (uintptr_t)addr;
 	uintptr_t base = (uintptr_t)cvm.base;
 
+	/*
+	 * 只判断驱动自己的区。应用自行申请的共享内存由应用负责释放，
+	 * 不会经过 mlx5_free()，所以这里不需要（也不应该）覆盖它们。
+	 */
 	if (!cvm.enabled || cvm.base == NULL)
 		return false;
 	return a >= base && a < base + cvm.len;
 }
 
+/*
+ * 问内核：这个地址属于哪块共享缓冲区？
+ *
+ * 应用可能自己向 /dev/cvm_shared 申请内存（例如 testpmd 的
+ * pinned-extbuf 池），那些区间不在驱动的记录里。内核掌握全部映射，
+ * 因此查不到时回落到内核查询。
+ *
+ * 返回的 fd 每次都是新的。注册用完即可关闭 —— umem 注册期间
+ * 内核侧已持有自己的引用。
+ */
+static bool
+cvm_kernel_lookup(const void *addr, int *fd, size_t *offset)
+{
+	struct cvm_shared_lookup_req req;
+	int dev;
+	bool ok = false;
+
+	if (!cvm.enabled)
+		return false;
+
+	dev = open(CVM_SHARED_DEV, O_RDWR);
+	if (dev < 0)
+		return false;
+
+	memset(&req, 0, sizeof(req));
+	req.va = (uint64_t)(uintptr_t)addr;
+	if (ioctl(dev, CVM_SHARED_IOC_LOOKUP, &req) == 0 && req.fd >= 0) {
+		if (fd != NULL)
+			*fd = req.fd;
+		else
+			close(req.fd);
+		if (offset != NULL)
+			*offset = req.offset;
+		ok = true;
+	}
+	close(dev);
+	return ok;
+}
+
 RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_lookup)
 bool
 mlx5_cvm_shared_lookup(const void *addr, int *fd, size_t *offset)
 {
-	if (!mlx5_cvm_shared_contains(addr))
-		return false;
-	if (fd != NULL)
-		*fd = cvm.fd;
-	if (offset != NULL)
-		*offset = (uintptr_t)addr - (uintptr_t)cvm.base;
-	return true;
+	if (mlx5_cvm_shared_contains(addr)) {
+		if (fd != NULL)
+			*fd = cvm.fd;
+		if (offset != NULL)
+			*offset = (uintptr_t)addr - (uintptr_t)cvm.base;
+		return true;
+	}
+	/* 不在驱动自己的区里，问内核 */
+	return cvm_kernel_lookup(addr, fd, offset);
 }
 
 RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_dma_map)
