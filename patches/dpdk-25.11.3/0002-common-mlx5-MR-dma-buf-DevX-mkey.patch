 drivers/common/mlx5/linux/mlx5_common_verbs.c | 143 +++++++++++++
 drivers/common/mlx5/linux/mlx5_cvm_shared.c   | 188 ++++++++++++++++++
 drivers/common/mlx5/linux/mlx5_cvm_shared.h   |  79 ++++++++
 4 files changed, 411 insertions(+)
 create mode 100644 drivers/common/mlx5/linux/mlx5_cvm_shared.c
