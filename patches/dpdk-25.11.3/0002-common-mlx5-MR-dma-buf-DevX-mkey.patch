index 815239b..107c376 100644
--- a/drivers/common/mlx5/linux/meson.build
+++ b/drivers/common/mlx5/linux/meson.build
@@ -53,6 +53,7 @@ if lib.found() and cc.links(min_c_code, dependencies: lib)
 endif
 
 sources += files('mlx5_nl.c')
