diff --git a/drivers/common/mlx5/linux/mlx5_common_verbs.c b/drivers/common/mlx5/linux/mlx5_common_verbs.c
index 98260df..f16592a 100644
--- a/drivers/common/mlx5/linux/mlx5_common_verbs.c
+++ b/drivers/common/mlx5/linux/mlx5_common_verbs.c
@@ -21,6 +21,8 @@
 #include <mlx5_malloc.h>
 #include <mlx5_common.h>
 #include <mlx5_common_mr.h>
+#include <mlx5_devx_cmds.h>
+#include "mlx5_cvm_shared.h"
 
 /**
  * Verbs callback to allocate a memory. This function should allocate the space
@@ -146,6 +148,136 @@ mlx5_common_verbs_dereg_mr(struct mlx5_pmd_mr *pmd_mr)
 	}
 }
 
+
+/**
+ * 以 dma-buf 方式注册内存区（机密虚拟机路径）。
+ *
+ * SNP guest 里 ibv_reg_mr 对普通内存返回 EIO；cvm_shared 分配的内存
+ * 又因 VM_PFNMAP 无法被 get_user_pages pin 住。两者都决定了必须走
+ * (dmabuf fd, 偏移) 这条注册路径。
+ *
+ * 流程与 Windows 版 mlx5_os_reg_mr 一致：先注册 umem，再基于
+ * umem_id 建 mkey。区别只在 umem 用 dmabuf fd 而非虚拟地址。
+ *
+ * @param[in] pd
+ *   保护域。
+ * @param[in] addr
+ *   共享区内的起始地址。
+ * @param[in] length
+ *   长度。
+ * @param[out] pmd_mr
+ *   填入 lkey、地址、长度、umem 对象与 mkey 对象。
+ *
+ * @return
+ *   0 成功，-1 失败。
+ */
+int
+mlx5_common_devx_reg_mr_dmabuf(void *pd, void *addr, size_t length,
+			       struct mlx5_pmd_mr *pmd_mr)
+{
+	struct mlx5dv_devx_umem_in umem_in;
+	struct mlx5dv_devx_umem *umem;
+	struct mlx5_devx_mkey_attr mkey_attr;
+	struct mlx5_devx_obj *mkey;
+	struct ibv_pd *ibv_pd = pd;
+	struct mlx5dv_obj dv_obj;
+	struct mlx5dv_pd dv_pd;
+	void *devx_ctx;
+	uint32_t pdn;
+	size_t offset = 0;
+	int fd = -1;
+
+	/*
+	 * reg_mr 回调只传入 pd，拿不到 pdn。Linux 上 pd 是 struct ibv_pd，
+	 * 用 dv_init_obj 反查 pdn；DevX 命令的上下文取自 pd->context。
+	 * （Windows 的 struct mlx5_pd 里直接带 pdn 与 devx_ctx，Linux 没有。）
+	 */
+	memset(&dv_obj, 0, sizeof(dv_obj));
+	memset(&dv_pd, 0, sizeof(dv_pd));
+	dv_obj.pd.in = ibv_pd;
+	dv_obj.pd.out = &dv_pd;
+	if (mlx5_glue->dv_init_obj(&dv_obj, MLX5DV_OBJ_PD) != 0) {
+		DRV_LOG(ERR, "无法从 pd 取得 pdn");
+		return -1;
+	}
+	pdn = dv_pd.pdn;
+	devx_ctx = ibv_pd->context;
+
+	if (!mlx5_cvm_shared_lookup(addr, &fd, &offset, NULL, NULL)) {
+		DRV_LOG(ERR,
+			"地址 %p 不在任何 cvm_shared 区域内，无法以 dma-buf 注册",
+			addr);
+		return -1;
+	}
+
+	memset(&umem_in, 0, sizeof(umem_in));
+	umem_in.addr = (void *)(uintptr_t)offset;
+	umem_in.size = length;
+	umem_in.access = IBV_ACCESS_LOCAL_WRITE |
+			 (haswell_broadwell_cpu ? 0 :
+			  IBV_ACCESS_RELAXED_ORDERING);
+	/*
+	 * pgsz_bitmap 必须非 0。置 0 时 rdma-core 返回 EINVAL，
+	 * 极易被误判成「不支持 dma-buf」。
+	 */
+	umem_in.pgsz_bitmap = ~0ULL;
+	umem_in.comp_mask = MLX5DV_UMEM_MASK_DMABUF;
+	umem_in.dmabuf_fd = fd;
+
+	umem = mlx5_glue->devx_umem_reg_ex(devx_ctx, &umem_in);
+	if (umem == NULL) {
+		DRV_LOG(ERR, "devx_umem_reg_ex 失败 (addr=%p len=%zu fd=%d): %s",
+			addr, length, fd, strerror(errno));
+		return -1;
+	}
+
+	memset(&mkey_attr, 0, sizeof(mkey_attr));
+	/*
+	 * start_addr 用虚拟地址：这样 WQE 里的数据段可以直填 VA，
+	 * 与 DPDK 的 IOVA=VA 模式一致，省掉一层偏移换算。已实测可行。
+	 */
+	mkey_attr.addr = (uintptr_t)addr;
+	mkey_attr.size = length;
+	mkey_attr.umem_id = umem->umem_id;
+	mkey_attr.pd = pdn;
+	mkey_attr.pg_access = 1;
+	if (!haswell_broadwell_cpu) {
+		mkey_attr.relaxed_ordering_write = 1;
+		mkey_attr.relaxed_ordering_read = 1;
+	}
+
+	mkey = mlx5_devx_cmd_mkey_create(devx_ctx, &mkey_attr);
+	if (mkey == NULL) {
+		DRV_LOG(ERR, "基于 umem_id=%u 创建 mkey 失败", umem->umem_id);
+		claim_zero(mlx5_glue->devx_umem_dereg(umem));
+		return -1;
+	}
+
+	pmd_mr->addr = addr;
+	pmd_mr->len = length;
+	pmd_mr->obj = (void *)umem;
+	pmd_mr->mkey = mkey;
+	pmd_mr->lkey = mkey->id;
+	DRV_LOG(DEBUG, "dma-buf MR 已注册: addr=%p len=%zu umem_id=%u lkey=0x%x",
+		addr, length, umem->umem_id, pmd_mr->lkey);
+	return 0;
+}
+
+/**
+ * 注销以 dma-buf 方式注册的 MR。
+ */
+void
+mlx5_common_devx_dereg_mr_dmabuf(struct mlx5_pmd_mr *pmd_mr)
+{
+	if (pmd_mr == NULL)
+		return;
+	if (pmd_mr->mkey != NULL)
+		claim_zero(mlx5_devx_cmd_destroy(pmd_mr->mkey));
+	if (pmd_mr->obj != NULL)
+		claim_zero(mlx5_glue->devx_umem_dereg(pmd_mr->obj));
+	memset(pmd_mr, 0, sizeof(*pmd_mr));
+}
+
 /**
  * Set the reg_mr and dereg_mr callbacks.
  *
@@ -158,6 +290,17 @@ RTE_EXPORT_INTERNAL_SYMBOL(mlx5_os_set_reg_mr_cb)
 void
 mlx5_os_set_reg_mr_cb(mlx5_reg_mr_t *reg_mr_cb, mlx5_dereg_mr_t *dereg_mr_cb)
 {
+	/*
+	 * 机密虚拟机里 ibv_reg_mr 对任何普通内存都返回 EIO，唯一可行的
+	 * 注册路径是 dma-buf + DevX mkey。cvm_shared 可用即切换过去。
+	 */
+	if (mlx5_cvm_shared_available()) {
+		DRV_LOG(INFO,
+			"检测到 cvm_shared，MR 注册改用 dma-buf + DevX mkey 路径");
+		*reg_mr_cb = mlx5_common_devx_reg_mr_dmabuf;
+		*dereg_mr_cb = mlx5_common_devx_dereg_mr_dmabuf;
+		return;
+	}
 	*reg_mr_cb = mlx5_common_verbs_reg_mr;
 	*dereg_mr_cb = mlx5_common_verbs_dereg_mr;
 }
diff --git a/drivers/common/mlx5/linux/mlx5_cvm_shared.c b/drivers/common/mlx5/linux/mlx5_cvm_shared.c
new file mode 100644
index 0000000..2a435ec
--- /dev/null
+++ b/drivers/common/mlx5/linux/mlx5_cvm_shared.c
@@ -0,0 +1,188 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright 2026
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <eal_export.h>
+#include <rte_common.h>
+#include <rte_log.h>
+#include <rte_malloc.h>
+#include <rte_rwlock.h>
+
+#include "mlx5_common_log.h"
+#include "mlx5_cvm_shared.h"
+
+/*
+ * 与内核模块 cvm_shared 的接口。此处内联定义而不引用内核头文件，
+ * 避免给 DPDK 构建引入外部依赖；两边必须保持一致。
+ */
+#define CVM_SHARED_DEV "/dev/cvm_shared"
+
+struct cvm_shared_alloc_req {
+	uint64_t size;
+	uint32_t flags;
+	int32_t fd;
+};
+
+#define CVM_SHARED_IOC_MAGIC 'C'
+#define CVM_SHARED_IOC_ALLOC \
+	_IOWR(CVM_SHARED_IOC_MAGIC, 0x01, struct cvm_shared_alloc_req)
+
+/** 一块已映射的共享区域。 */
+struct mlx5_cvm_region {
+	void *va;                     /* mmap 起始地址 */
+	size_t len;                   /* 长度 */
+	int fd;                       /* dma-buf fd，注册时要用 */
+	struct mlx5_cvm_region *next;
+};
+
+static struct mlx5_cvm_region *cvm_regions;
+static rte_rwlock_t cvm_lock = RTE_RWLOCK_INITIALIZER;
+
+RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_available)
+bool
+mlx5_cvm_shared_available(void)
+{
+	static int cached = -1;
+	int fd;
+
+	if (cached >= 0)
+		return cached != 0;
+
+	fd = open(CVM_SHARED_DEV, O_RDWR);
+	if (fd < 0) {
+		DRV_LOG(DEBUG, "cvm_shared 不可用: %s (%s)",
+			CVM_SHARED_DEV, strerror(errno));
+		cached = 0;
+	} else {
+		close(fd);
+		cached = 1;
+	}
+	return cached != 0;
+}
+
+RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_alloc)
+int
+mlx5_cvm_shared_alloc(size_t size, void **va_out)
+{
+	struct cvm_shared_alloc_req req = { .size = size, .flags = 0, .fd = -1 };
+	struct mlx5_cvm_region *reg;
+	void *va;
+	int dev, ret = 0;
+
+	*va_out = NULL;
+
+	dev = open(CVM_SHARED_DEV, O_RDWR);
+	if (dev < 0) {
+		DRV_LOG(ERR, "打开 %s 失败: %s", CVM_SHARED_DEV, strerror(errno));
+		return -errno;
+	}
+	if (ioctl(dev, CVM_SHARED_IOC_ALLOC, &req) < 0) {
+		ret = -errno;
+		DRV_LOG(ERR, "cvm_shared 分配 %zu 字节失败: %s",
+			size, strerror(errno));
+		close(dev);
+		return ret;
+	}
+	close(dev);
+
+	va = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, req.fd, 0);
+	if (va == MAP_FAILED) {
+		ret = -errno;
+		DRV_LOG(ERR, "映射共享区失败: %s", strerror(errno));
+		close(req.fd);
+		return ret;
+	}
+
+	reg = rte_zmalloc("mlx5_cvm_region", sizeof(*reg), 0);
+	if (reg == NULL) {
+		munmap(va, size);
+		close(req.fd);
+		return -ENOMEM;
+	}
+	reg->va = va;
+	reg->len = size;
+	reg->fd = req.fd;
+
+	rte_rwlock_write_lock(&cvm_lock);
+	reg->next = cvm_regions;
+	cvm_regions = reg;
+	rte_rwlock_write_unlock(&cvm_lock);
+
+	DRV_LOG(INFO, "共享区已就绪: va=%p len=%zu fd=%d", va, size, req.fd);
+	*va_out = va;
+	return 0;
+}
+
+RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_free)
+void
+mlx5_cvm_shared_free(void *va)
+{
+	struct mlx5_cvm_region *reg, **pp;
+
+	rte_rwlock_write_lock(&cvm_lock);
+	for (pp = &cvm_regions; (reg = *pp) != NULL; pp = &reg->next) {
+		if (reg->va == va) {
+			*pp = reg->next;
+			break;
+		}
+	}
+	rte_rwlock_write_unlock(&cvm_lock);
+
+	if (reg == NULL) {
+		DRV_LOG(ERR, "释放未知的共享区 %p", va);
+		return;
+	}
+
+	/*
+	 * 顺序无关紧要：dma-buf 的引用计数要等 munmap 之后才归零，
+	 * 内核模块此时才把页转回私有。close(fd) 不会提前触发。
+	 */
+	munmap(reg->va, reg->len);
+	close(reg->fd);
+	rte_free(reg);
+}
+
+RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_lookup)
+bool
+mlx5_cvm_shared_lookup(const void *addr, int *fd, size_t *offset,
+		       void **base, size_t *len)
+{
+	const uintptr_t a = (uintptr_t)addr;
+	struct mlx5_cvm_region *reg;
+	bool found = false;
+
+	rte_rwlock_read_lock(&cvm_lock);
+	for (reg = cvm_regions; reg != NULL; reg = reg->next) {
+		uintptr_t start = (uintptr_t)reg->va;
+
+		if (a >= start && a < start + reg->len) {
+			if (fd != NULL)
+				*fd = reg->fd;
+			if (offset != NULL)
+				*offset = a - start;
+			if (base != NULL)
+				*base = reg->va;
+			if (len != NULL)
+				*len = reg->len;
+			found = true;
+			break;
+		}
+	}
+	rte_rwlock_read_unlock(&cvm_lock);
+	return found;
+}
+
+RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_contains)
+bool
+mlx5_cvm_shared_contains(const void *addr)
+{
+	return mlx5_cvm_shared_lookup(addr, NULL, NULL, NULL, NULL);
+}
diff --git a/drivers/common/mlx5/linux/mlx5_cvm_shared.h b/drivers/common/mlx5/linux/mlx5_cvm_shared.h
new file mode 100644
index 0000000..ceb60c1
--- /dev/null
+++ b/drivers/common/mlx5/linux/mlx5_cvm_shared.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright 2026
+ */
+/*
+ * 机密虚拟机（SEV-SNP）下的共享 DMA 内存管理。
+ *
+ * 背景
+ * ----
+ * SNP guest 里 guest 内存默认是私有加密页，RMP 会拒绝设备对其 DMA。
+ * 实测：ibv_reg_mr 与 devx_umem_reg 对普通内存和大页一律返回 EIO；
+ * 内核网络能工作是因为 DMA API 会把数据 bounce 到 swiotlb 的共享池，
+ * 但 swiotlb 单次映射上限约 1MB，且 bounce 与 DPDK 的零拷贝相悖。
+ *
+ * 解法是引入第三类内存：已转共享（C-bit 清除、RMP 标记 shared）
+ * 但不归 swiotlb 管，由 cvm_shared 内核模块以 dma-buf 形式导出。
+ *
+ * 本模块负责在 DPDK 侧管理这些区域，并提供地址查找 —— 因为注册只能
+ * 走 (dmabuf fd, 偏移)，不能走虚拟地址：内核模块用 remap_pfn_range
+ * 建立用户映射，vma 带 VM_PFNMAP，get_user_pages 无法 pin，
+ * 所以 ibv_reg_mr 这条路是死的。
+ */
+#ifndef RTE_PMD_MLX5_CVM_SHARED_H_
+#define RTE_PMD_MLX5_CVM_SHARED_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/** cvm_shared 是否可用（内核模块已加载且可打开）。 */
+__rte_internal
+bool mlx5_cvm_shared_available(void);
+
+/**
+ * 从内核模块申请一块共享内存并映射到本进程。
+ *
+ * @param size   请求字节数，向上对齐到页。
+ * @param[out] va 映射后的起始地址。
+ * @return 0 成功，负值为 -errno。
+ */
+__rte_internal
+int mlx5_cvm_shared_alloc(size_t size, void **va);
+
+/**
+ * 释放先前申请的区域。
+ *
+ * 注意生命周期：dma-buf 的引用计数在 munmap **之后**才归零，
+ * 内核模块此时才把页转回私有。close(fd) 本身不会提前转回。
+ */
+__rte_internal
+void mlx5_cvm_shared_free(void *va);
+
+/**
+ * 地址查找：给定区内任一地址，返回其所属区域的 dma-buf fd 与偏移。
+ *
+ * MR 注册路径需要它，因为 reg_mr 回调拿到的是虚拟地址，
+ * 而 devx_umem_reg_ex 需要 (fd, 偏移)。
+ *
+ * @param addr        区内任一地址。
+ * @param[out] fd     该区域的 dma-buf fd。
+ * @param[out] offset addr 相对区域起点的偏移。
+ * @param[out] base   区域起始地址，可为 NULL。
+ * @param[out] len    区域长度，可为 NULL。
+ * @return true 表示 addr 落在某个共享区内。
+ */
+__rte_internal
+bool mlx5_cvm_shared_lookup(const void *addr, int *fd, size_t *offset,
+			    void **base, size_t *len);
+
+/**
+ * addr 是否落在任一共享区内。
+ *
+ * MR 缓存的 miss 路径用它做显式拒绝：对共享区地址回退到普通
+ * ibv_reg_mr 必然失败，而失败发生在数据面，表现为丢包或卡死，
+ * 不是启动期的明确报错。宁可在这里直接报错。
+ */
+__rte_internal
+bool mlx5_cvm_shared_contains(const void *addr);
+
+#endif /* RTE_PMD_MLX5_CVM_SHARED_H_ */
-- 
2.53.0

