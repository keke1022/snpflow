diff --git a/app/test-pmd/cvm_chunk_receiver.c b/app/test-pmd/cvm_chunk_receiver.c
new file mode 100644
index 0000000..8b567fc
--- /dev/null
+++ b/app/test-pmd/cvm_chunk_receiver.c
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "cvm_chunk_receiver.h"
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <openssl/crypto.h>
+
+static void
+bitmap_set(struct cvm_chunk_receiver *receiver, uint64_t chunk_id)
+{
+	receiver->bitmap[chunk_id / 64] |= UINT64_C(1) << (chunk_id % 64);
+}
+
+bool
+cvm_chunk_receiver_has(const struct cvm_chunk_receiver *receiver,
+		uint64_t chunk_id)
+{
+	if (receiver == NULL || !receiver->initialized ||
+	    chunk_id >= receiver->total_chunks)
+		return false;
+	return (receiver->bitmap[chunk_id / 64] &
+		(UINT64_C(1) << (chunk_id % 64))) != 0;
+}
+
+static int
+receiver_start_object(struct cvm_chunk_receiver *receiver,
+		const struct cvm_chunk_header *header)
+{
+	size_t bitmap_words;
+
+	if (header->object_len > SIZE_MAX ||
+	    header->total_chunks > (uint64_t)SIZE_MAX - 63)
+		return -EOVERFLOW;
+	bitmap_words = (size_t)((header->total_chunks + 63) / 64);
+	if (bitmap_words > SIZE_MAX / sizeof(*receiver->bitmap))
+		return -EOVERFLOW;
+	receiver->object = calloc(1, (size_t)header->object_len);
+	receiver->bitmap = calloc(bitmap_words, sizeof(*receiver->bitmap));
+	if (receiver->object == NULL || receiver->bitmap == NULL) {
+		free(receiver->object);
+		free(receiver->bitmap);
+		receiver->object = NULL;
+		receiver->bitmap = NULL;
+		return -ENOMEM;
+	}
+	receiver->session_id = header->session_id;
+	receiver->object_id = header->object_id;
+	receiver->object_len = header->object_len;
+	receiver->total_chunks = header->total_chunks;
+	receiver->key_epoch = header->key_epoch;
+	receiver->bitmap_words = bitmap_words;
+	receiver->received_chunks = 0;
+	receiver->ack_base = 0;
+	receiver->ack_message_seq = 0;
+	receiver->initialized = true;
+	return 0;
+}
+
+static bool
+same_object(const struct cvm_chunk_receiver *receiver,
+		const struct cvm_chunk_header *header)
+{
+	return receiver->session_id == header->session_id &&
+	       receiver->object_id == header->object_id &&
+	       receiver->object_len == header->object_len &&
+	       receiver->total_chunks == header->total_chunks &&
+	       receiver->key_epoch == header->key_epoch;
+}
+
+int
+cvm_chunk_receiver_init(struct cvm_chunk_receiver *receiver,
+		const uint8_t key[CVM_CHUNK_KEY_SIZE], uint64_t max_object_len)
+{
+	if (receiver == NULL || key == NULL || max_object_len == 0 ||
+	    max_object_len > SIZE_MAX)
+		return -EINVAL;
+	memset(receiver, 0, sizeof(*receiver));
+	memcpy(receiver->key, key, CVM_CHUNK_KEY_SIZE);
+	receiver->max_object_len = max_object_len;
+	return 0;
+}
+
+void
+cvm_chunk_receiver_destroy(struct cvm_chunk_receiver *receiver)
+{
+	if (receiver == NULL)
+		return;
+	if (receiver->object != NULL) {
+		OPENSSL_cleanse(receiver->object, (size_t)receiver->object_len);
+		free(receiver->object);
+	}
+	if (receiver->bitmap != NULL) {
+		OPENSSL_cleanse(receiver->bitmap,
+				receiver->bitmap_words * sizeof(*receiver->bitmap));
+		free(receiver->bitmap);
+	}
+	OPENSSL_cleanse(receiver, sizeof(*receiver));
+}
+
+int
+cvm_chunk_receiver_accept(struct cvm_chunk_receiver *receiver,
+		const uint8_t *packet, size_t packet_len,
+		enum cvm_chunk_accept_result *result)
+{
+	uint8_t plaintext[CVM_CHUNK_DATA_SIZE];
+	struct cvm_chunk_header header;
+	uint64_t offset;
+	int ret;
+
+	if (receiver == NULL || packet == NULL || result == NULL)
+		return -EINVAL;
+	ret = cvm_chunk_packet_open(receiver->key, packet, packet_len, &header,
+				    plaintext, sizeof(plaintext));
+	if (ret != 0)
+		goto out;
+	ret = cvm_chunk_data_header_validate(&header,
+			receiver->max_object_len);
+	if (ret != 0)
+		goto out;
+	/* No allocation or receiver-state mutation occurs before authentication. */
+	if (!receiver->initialized) {
+		ret = receiver_start_object(receiver, &header);
+		if (ret != 0)
+			goto out;
+	} else if (!same_object(receiver, &header)) {
+		ret = -EXDEV;
+		goto out;
+	}
+	if (cvm_chunk_receiver_has(receiver, header.chunk_id)) {
+		*result = CVM_CHUNK_ACCEPT_DUPLICATE;
+		ret = 0;
+		goto out;
+	}
+	ret = cvm_chunk_data_offset(&header, &offset);
+	if (ret != 0 || offset > receiver->object_len - header.payload_len) {
+		ret = -EOVERFLOW;
+		goto out;
+	}
+	memcpy(receiver->object + offset, plaintext, header.payload_len);
+	/* Commit the replay/placement state only after authentication and copy. */
+	bitmap_set(receiver, header.chunk_id);
+	receiver->received_chunks++;
+	while (receiver->ack_base < receiver->total_chunks &&
+	       cvm_chunk_receiver_has(receiver, receiver->ack_base))
+		receiver->ack_base++;
+	*result = receiver->received_chunks == receiver->total_chunks ?
+		CVM_CHUNK_ACCEPT_COMPLETE : CVM_CHUNK_ACCEPT_NEW;
+	ret = 0;
+out:
+	OPENSSL_cleanse(plaintext, sizeof(plaintext));
+	return ret;
+}
+
+int
+cvm_chunk_receiver_build_ack(struct cvm_chunk_receiver *receiver,
+		uint8_t *packet, size_t packet_capacity, size_t *packet_len)
+{
+	uint8_t plaintext[CVM_CHUNK_ACK_BITMAP_SIZE];
+	struct cvm_chunk_header header;
+	uint64_t bitmap = 0;
+	uint64_t i;
+	int ret;
+
+	if (receiver == NULL || !receiver->initialized || packet == NULL ||
+	    packet_len == NULL ||
+	    receiver->ack_message_seq > CVM_CHUNK_MAX_MESSAGE_SEQ)
+		return -EINVAL;
+	for (i = 0; i < 64 && receiver->ack_base + i < receiver->total_chunks;
+	     i++) {
+		if (cvm_chunk_receiver_has(receiver, receiver->ack_base + i))
+			bitmap |= UINT64_C(1) << i;
+	}
+	cvm_chunk_ack_bitmap_encode(plaintext, bitmap);
+	header = (struct cvm_chunk_header) {
+		.flags = CVM_CHUNK_F_ACK,
+		.key_epoch = receiver->key_epoch,
+		.session_id = receiver->session_id,
+		.object_id = receiver->object_id,
+		.chunk_id = receiver->ack_base,
+		.total_chunks = receiver->total_chunks,
+		.object_len = receiver->object_len,
+		.message_seq = receiver->ack_message_seq,
+		.payload_len = CVM_CHUNK_ACK_BITMAP_SIZE,
+	};
+	ret = cvm_chunk_packet_build(receiver->key, &header, plaintext, packet,
+				     packet_capacity, packet_len);
+	if (ret == 0)
+		receiver->ack_message_seq++;
+	OPENSSL_cleanse(plaintext, sizeof(plaintext));
+	return ret;
+}
diff --git a/app/test-pmd/cvm_chunk_receiver.h b/app/test-pmd/cvm_chunk_receiver.h
new file mode 100644
index 0000000..510af24
--- /dev/null
+++ b/app/test-pmd/cvm_chunk_receiver.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef CVM_CHUNK_RECEIVER_H
+#define CVM_CHUNK_RECEIVER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "cvm_chunk_packet.h"
+
+enum cvm_chunk_accept_result {
+	CVM_CHUNK_ACCEPT_NEW = 0,
+	CVM_CHUNK_ACCEPT_DUPLICATE,
+	CVM_CHUNK_ACCEPT_COMPLETE,
+};
+
+struct cvm_chunk_receiver {
+	uint8_t key[CVM_CHUNK_KEY_SIZE];
+	uint64_t max_object_len;
+	uint64_t session_id;
+	uint64_t object_id;
+	uint64_t object_len;
+	uint64_t total_chunks;
+	uint64_t received_chunks;
+	uint64_t ack_base;
+	uint64_t ack_message_seq;
+	uint32_t key_epoch;
+	uint8_t *object;
+	uint64_t *bitmap;
+	size_t bitmap_words;
+	bool initialized;
+};
+
+int cvm_chunk_receiver_init(struct cvm_chunk_receiver *receiver,
+		const uint8_t key[CVM_CHUNK_KEY_SIZE], uint64_t max_object_len);
+
+void cvm_chunk_receiver_destroy(struct cvm_chunk_receiver *receiver);
+
+int cvm_chunk_receiver_accept(struct cvm_chunk_receiver *receiver,
+		const uint8_t *packet, size_t packet_len,
+		enum cvm_chunk_accept_result *result);
+
+int cvm_chunk_receiver_build_ack(struct cvm_chunk_receiver *receiver,
+		uint8_t *packet, size_t packet_capacity, size_t *packet_len);
+
+bool cvm_chunk_receiver_has(const struct cvm_chunk_receiver *receiver,
+		uint64_t chunk_id);
+
+#endif /* CVM_CHUNK_RECEIVER_H */
diff --git a/app/test-pmd/cvm_chunk_wire.c b/app/test-pmd/cvm_chunk_wire.c
new file mode 100644
index 0000000..ca8bcff
--- /dev/null
+++ b/app/test-pmd/cvm_chunk_wire.c
@@ -0,0 +1,177 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+
+#include "cvm_chunk_wire.h"
+
+#include <errno.h>
+#include <limits.h>
+
+static void
+put_u16(uint8_t *p, uint16_t value)
+{
+	p[0] = (uint8_t)(value >> 8);
+	p[1] = (uint8_t)value;
+}
+
+static void
+put_u32(uint8_t *p, uint32_t value)
+{
+	p[0] = (uint8_t)(value >> 24);
+	p[1] = (uint8_t)(value >> 16);
+	p[2] = (uint8_t)(value >> 8);
+	p[3] = (uint8_t)value;
+}
+
+static void
+put_u64(uint8_t *p, uint64_t value)
+{
+	put_u32(p, (uint32_t)(value >> 32));
+	put_u32(p + 4, (uint32_t)value);
+}
+
+static uint16_t
+get_u16(const uint8_t *p)
+{
+	return (uint16_t)(((uint16_t)p[0] << 8) | p[1]);
+}
+
+static uint32_t
+get_u32(const uint8_t *p)
+{
+	return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) |
+	       ((uint32_t)p[2] << 8) | p[3];
+}
+
+static uint64_t
+get_u64(const uint8_t *p)
+{
+	return ((uint64_t)get_u32(p) << 32) | get_u32(p + 4);
+}
+
+void
+cvm_chunk_header_encode(uint8_t out[CVM_CHUNK_HEADER_SIZE],
+		const struct cvm_chunk_header *header)
+{
+	put_u32(out + 0, CVM_CHUNK_MAGIC);
+	put_u16(out + 4, CVM_CHUNK_VERSION);
+	put_u16(out + 6, CVM_CHUNK_HEADER_SIZE);
+	put_u32(out + 8, header->flags);
+	put_u32(out + 12, header->key_epoch);
+	put_u64(out + 16, header->session_id);
+	put_u64(out + 24, header->object_id);
+	put_u64(out + 32, header->chunk_id);
+	put_u64(out + 40, header->total_chunks);
+	put_u64(out + 48, header->object_len);
+	put_u64(out + 56, header->message_seq);
+	put_u32(out + 64, header->payload_len);
+	put_u32(out + 68, 0);
+}
+
+int
+cvm_chunk_header_decode(struct cvm_chunk_header *header,
+		const uint8_t *wire, size_t wire_len)
+{
+	if (header == NULL || wire == NULL || wire_len < CVM_CHUNK_HEADER_SIZE)
+		return -EMSGSIZE;
+	if (get_u32(wire + 0) != CVM_CHUNK_MAGIC ||
+	    get_u16(wire + 4) != CVM_CHUNK_VERSION ||
+	    get_u16(wire + 6) != CVM_CHUNK_HEADER_SIZE ||
+	    get_u32(wire + 68) != 0)
+		return -EPROTO;
+	header->flags = get_u32(wire + 8);
+	header->key_epoch = get_u32(wire + 12);
+	header->session_id = get_u64(wire + 16);
+	header->object_id = get_u64(wire + 24);
+	header->chunk_id = get_u64(wire + 32);
+	header->total_chunks = get_u64(wire + 40);
+	header->object_len = get_u64(wire + 48);
+	header->message_seq = get_u64(wire + 56);
+	header->payload_len = get_u32(wire + 64);
+	return 0;
+}
+
+int
+cvm_chunk_data_offset(const struct cvm_chunk_header *header, uint64_t *offset)
+{
+	if (header == NULL || offset == NULL ||
+	    header->chunk_id > UINT64_MAX / CVM_CHUNK_DATA_SIZE)
+		return -EOVERFLOW;
+	*offset = header->chunk_id * CVM_CHUNK_DATA_SIZE;
+	return 0;
+}
+
+int
+cvm_chunk_data_header_validate(const struct cvm_chunk_header *header,
+		uint64_t max_object_len)
+{
+	uint64_t expected_chunks;
+	uint64_t expected_len;
+	uint64_t offset;
+
+	if (header == NULL || header->flags != CVM_CHUNK_F_DATA ||
+	    header->session_id == 0 || header->object_id == 0 ||
+	    header->object_len == 0 || header->object_len > max_object_len ||
+	    header->message_seq != header->chunk_id ||
+	    header->message_seq > CVM_CHUNK_MAX_MESSAGE_SEQ)
+		return -EINVAL;
+	/* Division plus remainder avoids overflowing object_len near UINT64_MAX. */
+	expected_chunks = header->object_len / CVM_CHUNK_DATA_SIZE;
+	expected_chunks += header->object_len % CVM_CHUNK_DATA_SIZE != 0;
+	/* Every DATA chunk uses chunk_id as its 31-bit nonce sequence. */
+	if (expected_chunks > CVM_CHUNK_MAX_MESSAGE_SEQ + 1 ||
+	    header->total_chunks != expected_chunks ||
+	    header->chunk_id >= header->total_chunks)
+		return -EINVAL;
+	if (cvm_chunk_data_offset(header, &offset) != 0 ||
+	    offset >= header->object_len)
+		return -EINVAL;
+	expected_len = header->object_len - offset;
+	if (expected_len > CVM_CHUNK_DATA_SIZE)
+		expected_len = CVM_CHUNK_DATA_SIZE;
+	if (header->payload_len != expected_len)
+		return -EINVAL;
+	return 0;
+}
+
+int
+cvm_chunk_ack_header_validate(const struct cvm_chunk_header *header,
+		uint64_t expected_session_id, uint64_t expected_object_id,
+		uint64_t expected_total_chunks, uint64_t expected_object_len,
+		uint32_t expected_key_epoch)
+{
+	if (header == NULL || header->flags != CVM_CHUNK_F_ACK ||
+	    header->session_id != expected_session_id ||
+	    header->object_id != expected_object_id ||
+	    header->total_chunks != expected_total_chunks ||
+	    header->object_len != expected_object_len ||
+	    header->key_epoch != expected_key_epoch ||
+	    header->payload_len != CVM_CHUNK_ACK_BITMAP_SIZE ||
+	    header->chunk_id > header->total_chunks ||
+	    header->message_seq > CVM_CHUNK_MAX_MESSAGE_SEQ)
+		return -EINVAL;
+	return 0;
+}
+
+void
+cvm_chunk_nonce(uint8_t nonce[CVM_CHUNK_NONCE_SIZE],
+		const struct cvm_chunk_header *header)
+{
+	uint32_t suffix = (uint32_t)header->message_seq;
+
+	if (header->flags == CVM_CHUNK_F_ACK)
+		suffix |= UINT32_C(0x80000000);
+	put_u64(nonce, header->object_id);
+	put_u32(nonce + 8, suffix);
+}
+
+void
+cvm_chunk_ack_bitmap_encode(uint8_t out[CVM_CHUNK_ACK_BITMAP_SIZE],
+		uint64_t bitmap)
+{
+	put_u64(out, bitmap);
+}
+
+uint64_t
+cvm_chunk_ack_bitmap_decode(const uint8_t in[CVM_CHUNK_ACK_BITMAP_SIZE])
+{
+	return get_u64(in);
+}
diff --git a/app/test-pmd/cvm_chunk_wire.h b/app/test-pmd/cvm_chunk_wire.h
new file mode 100644
index 0000000..8445d39
--- /dev/null
+++ b/app/test-pmd/cvm_chunk_wire.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+#ifndef CVM_CHUNK_WIRE_H
+#define CVM_CHUNK_WIRE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define CVM_CHUNK_MAGIC UINT32_C(0x43564d43) /* "CVMC" */
+#define CVM_CHUNK_VERSION UINT16_C(1)
+#define CVM_CHUNK_HEADER_SIZE 72U
+#define CVM_CHUNK_TAG_SIZE 16U
+#define CVM_CHUNK_NONCE_SIZE 12U
+#define CVM_CHUNK_MAX_UDP_PAYLOAD 1472U
+#define CVM_CHUNK_DATA_SIZE \
+	(CVM_CHUNK_MAX_UDP_PAYLOAD - CVM_CHUNK_HEADER_SIZE - CVM_CHUNK_TAG_SIZE)
+#define CVM_CHUNK_ACK_BITMAP_SIZE 8U
+#define CVM_CHUNK_MAX_MESSAGE_SEQ UINT64_C(0x7fffffff)
+
+#define CVM_CHUNK_F_DATA UINT32_C(0x00000001)
+#define CVM_CHUNK_F_ACK  UINT32_C(0x00000002)
+
+struct cvm_chunk_header {
+	uint32_t flags;
+	uint32_t key_epoch;
+	uint64_t session_id;
+	uint64_t object_id;
+	uint64_t chunk_id;
+	uint64_t total_chunks;
+	uint64_t object_len;
+	uint64_t message_seq;
+	uint32_t payload_len;
+};
+
+void cvm_chunk_header_encode(uint8_t out[CVM_CHUNK_HEADER_SIZE],
+		const struct cvm_chunk_header *header);
+
+int cvm_chunk_header_decode(struct cvm_chunk_header *header,
+		const uint8_t *wire, size_t wire_len);
+
+int cvm_chunk_data_header_validate(const struct cvm_chunk_header *header,
+		uint64_t max_object_len);
+
+int cvm_chunk_ack_header_validate(const struct cvm_chunk_header *header,
+		uint64_t expected_session_id, uint64_t expected_object_id,
+		uint64_t expected_total_chunks, uint64_t expected_object_len,
+		uint32_t expected_key_epoch);
+
+int cvm_chunk_data_offset(const struct cvm_chunk_header *header,
+		uint64_t *offset);
+
+void cvm_chunk_nonce(uint8_t nonce[CVM_CHUNK_NONCE_SIZE],
+		const struct cvm_chunk_header *header);
+
+void cvm_chunk_ack_bitmap_encode(uint8_t out[CVM_CHUNK_ACK_BITMAP_SIZE],
+		uint64_t bitmap);
+
+uint64_t cvm_chunk_ack_bitmap_decode(
+		const uint8_t in[CVM_CHUNK_ACK_BITMAP_SIZE]);
+
+#endif /* CVM_CHUNK_WIRE_H */
