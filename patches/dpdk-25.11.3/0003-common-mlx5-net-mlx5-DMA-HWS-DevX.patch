+/* ------------------------------------------------------------------ */
+/* 带对齐的子分配器                                                    */
+/* ------------------------------------------------------------------ */
+
+RTE_EXPORT_INTERNAL_SYMBOL(mlx5_cvm_shared_alloc)
+void *
+mlx5_cvm_shared_alloc(size_t size, size_t align)
+{
+	struct cvm_chunk *c;
+	void *result = NULL;
+
+	if (!cvm.enabled || size == 0)
+		return NULL;
+	if (align == 0)
+		align = RTE_CACHE_LINE_SIZE;
+
+	rte_rwlock_write_lock(&cvm.lock);
+	for (c = cvm.chunks; c != NULL; c = c->next) {
+		uintptr_t start, aligned;
+		size_t lead, need;
+
+		if (c->used)
+			continue;
+		start = (uintptr_t)c->addr;
+		aligned = RTE_ALIGN_CEIL(start, align);
+		lead = aligned - start;
+		need = lead + size;
+		if (c->size < need)
+			continue;
+
+		/* 对齐产生的前段留作空闲块 */
+		if (lead != 0) {
+			struct cvm_chunk *head = rte_zmalloc("cvm_chunk",
+							     sizeof(*head), 0);
+			if (head == NULL)
+				break;
+			head->addr = c->addr;
+			head->size = lead;
+			head->used = false;
+			head->next = c;
+			/* 把 head 插到 c 之前 */
+			if (cvm.chunks == c) {
+				cvm.chunks = head;
+			} else {
+				struct cvm_chunk *p = cvm.chunks;
+				while (p->next != c)
+					p = p->next;
+				p->next = head;
+			}
+			c->addr = (void *)aligned;
+			c->size -= lead;
 		}
+
+		/* 尾部多余的切成新的空闲块 */
+		if (c->size > size) {
+			struct cvm_chunk *tail = rte_zmalloc("cvm_chunk",
+							     sizeof(*tail), 0);
+			if (tail == NULL)
+				break;
+			tail->addr = (void *)((uintptr_t)c->addr + size);
+			tail->size = c->size - size;
+			tail->used = false;
+			tail->next = c->next;
+			c->next = tail;
+			c->size = size;
+		}
+
+		c->used = true;
+		result = c->addr;
+		break;
 	}
-	rte_rwlock_read_unlock(&cvm_lock);
-	return found;
+	rte_rwlock_write_unlock(&cvm.lock);
+
+	if (result == NULL) {
+		/*
+		 * 严格模式下不回退到普通内存：那只会把失败推迟到
+		 * 注册或数据面，变成更难排查的问题。
+		 */
+		DRV_LOG(ERR,
+			"共享区已用尽，无法分配 %zu 字节（对齐 %zu）。"
+			"请增大共享区大小。",
+			size, align);
+	}
+	return result;
+}
