-REGISTER_DRIVER_TEST(cryptodev_scheduler_autotest, test_cryptodev_scheduler);
-
+#else
+static int
+test_cryptodev_scheduler(void)
+{
+	printf("Crypto scheduler driver is not built, skipping test\n");
+	return TEST_SKIPPED;
+}
 #endif
 
+REGISTER_DRIVER_TEST(cryptodev_scheduler_autotest, test_cryptodev_scheduler);
+
