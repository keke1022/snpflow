+REGISTER_FAST_TEST(bpf_subtract_one_autotest, true, true, test_subtract_one);
 
 /*
  * Conditionally jump over invalid operation as first instruction.
@@ -242,7 +242,7 @@ test_jump_over_invalid_first(void)
