diff --git a/drivers/net/mlx5/mlx5_tx_validate.h b/drivers/net/mlx5/mlx5_tx_validate.h
new file mode 100644
index 0000000..6f2e53d
--- /dev/null
+++ b/drivers/net/mlx5/mlx5_tx_validate.h
@@ -0,0 +1,48 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright (c) 2026
+ */
+
+#ifndef MLX5_TX_VALIDATE_H_
+#define MLX5_TX_VALIDATE_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+enum mlx5_tx_cvm_guard_result {
+	MLX5_TX_CVM_GUARD_OK = 0,
+	MLX5_TX_CVM_GUARD_NO_REQUEST,
+	MLX5_TX_CVM_GUARD_WQE_COUNTER,
+};
+
+static inline uint32_t
+mlx5_tx_fcq_make(uint16_t elts_head, uint16_t wqe_counter)
+{
+	return (uint32_t)elts_head | ((uint32_t)wqe_counter << 16);
+}
+
+static inline uint16_t
+mlx5_tx_fcq_elts_head(uint32_t entry)
+{
+	return (uint16_t)entry;
+}
+
+static inline uint16_t
+mlx5_tx_fcq_wqe_counter(uint32_t entry)
+{
+	return (uint16_t)(entry >> 16);
+}
+
+static inline enum mlx5_tx_cvm_guard_result
+mlx5_tx_cvm_cqe_validate(bool enabled, uint16_t cq_ci, uint16_t cq_pi,
+			 uint32_t fcq_entry, uint16_t cqe_wqe_counter)
+{
+	if (!enabled)
+		return MLX5_TX_CVM_GUARD_OK;
+	if (cq_ci == cq_pi)
+		return MLX5_TX_CVM_GUARD_NO_REQUEST;
+	if (mlx5_tx_fcq_wqe_counter(fcq_entry) != cqe_wqe_counter)
+		return MLX5_TX_CVM_GUARD_WQE_COUNTER;
+	return MLX5_TX_CVM_GUARD_OK;
+}
+
+#endif /* MLX5_TX_VALIDATE_H_ */
