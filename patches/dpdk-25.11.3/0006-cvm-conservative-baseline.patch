diff --git a/app/test/test_mlx5_rx_validate.c b/app/test/test_mlx5_rx_validate.c
new file mode 100644
index 0000000..e723567
--- /dev/null
+++ b/app/test/test_mlx5_rx_validate.c
@@ -0,0 +1,174 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright (c) 2026
+ */
+
+#include <stdint.h>
+
+#include "test.h"
+#include "../../drivers/net/mlx5/mlx5_rx_validate.h"
+
+static int
+test_compressed_budget(void)
+{
+	uint32_t budget = UINT32_MAX;
+
+	/* Regression: rq_pi was advanced by 3, then nocmp_n was subtracted again. */
+	TEST_ASSERT(mlx5_rx_comp_budget_calc(256, 0, 256, 0, 4, 3, &budget),
+		"budget calculation rejected a valid one-entry remainder");
+	TEST_ASSERT_EQUAL(budget, 1,
+		"posted=4 and consumed=3 must leave exactly one entry");
+
+	/* Regression: MPRQ capacities were narrowed to uint16_t before taking min. */
+	TEST_ASSERT(mlx5_rx_comp_budget_calc(256, 0, 131072, 0, 65536, 0,
+						&budget),
+		"large MPRQ capacity was rejected");
+	TEST_ASSERT_EQUAL(budget, 256,
+		"CQ capacity must bound a large MPRQ capacity without truncation");
+
+	TEST_ASSERT(mlx5_rx_comp_budget_calc(256, 200, 512, 400, 100, 0,
+						&budget),
+		"ring-tail budget was rejected");
+	TEST_ASSERT_EQUAL(budget, 56,
+		"CQ tail must be the limiting contiguous capacity");
+
+	TEST_ASSERT(!mlx5_rx_comp_budget_calc(256, 0, 256, 0, 4, 5,
+						 &budget),
+		"consuming more entries than posted must be rejected");
+	TEST_ASSERT_EQUAL(budget, 0,
+		"failed calculation must clear the output budget");
+
+	TEST_ASSERT(!mlx5_rx_comp_budget_calc(256, 257, 256, 0, 4, 0,
+						 &budget),
+		"CQ offset beyond the array must be rejected");
+	TEST_ASSERT(!mlx5_rx_comp_budget_calc(256, 0, 256, 257, 4, 0,
+						 &budget),
+		"elts offset beyond the array must be rejected");
+	TEST_ASSERT(!mlx5_rx_comp_budget_calc(256, 0, 256, 0, 0, 0,
+						 &budget),
+		"zero posted capacity must be rejected");
+	TEST_ASSERT(!mlx5_rx_comp_budget_calc(256, 0, 256, 0, 4, 0, NULL),
+		"NULL output pointer must be rejected");
+
+	TEST_ASSERT(mlx5_rx_comp_budget_calc(UINT32_MAX, 0, UINT32_MAX, 0,
+						UINT32_MAX, 0, &budget),
+		"full uint32_t capacity must not overflow");
+	TEST_ASSERT_EQUAL(budget, UINT32_MAX,
+		"full uint32_t capacity changed unexpectedly");
+	return TEST_SUCCESS;
+}
+
+static int
+test_compressed_count(void)
+{
+	uint16_t count = UINT16_C(0xa5a5);
+
+	TEST_ASSERT(mlx5_rx_mcqe_count_valid(1, 64, 0, &count),
+		"count one was rejected");
+	TEST_ASSERT_EQUAL(count, 1, "validated count was not returned");
+
+	TEST_ASSERT(mlx5_rx_mcqe_count_valid(34, 64, 30, &count),
+		"count exactly filling the budget was rejected");
+	TEST_ASSERT_EQUAL(count, 34, "exact-fill count was not returned");
+
+	count = UINT16_C(0xa5a5);
+	TEST_ASSERT(!mlx5_rx_mcqe_count_valid(35, 64, 30, &count),
+		"count exceeding accumulated budget by one was accepted");
+	TEST_ASSERT_EQUAL(count, UINT16_C(0xa5a5),
+		"failed validation must not modify output count");
+
+	TEST_ASSERT(!mlx5_rx_mcqe_count_valid(0, 64, 0, &count),
+		"zero count was accepted");
+	TEST_ASSERT(!mlx5_rx_mcqe_count_valid(UINT32_C(0x10001), 64, 0,
+						&count),
+		"32-bit count that truncates to one was accepted");
+	TEST_ASSERT(!mlx5_rx_mcqe_count_valid(UINT32_C(0x10000), UINT32_MAX,
+						0, &count),
+		"count wider than the uint16_t consumer was accepted");
+
+	TEST_ASSERT(mlx5_rx_mcqe_count_valid(UINT16_MAX, UINT32_C(65536), 0,
+					       &count),
+		"UINT16_MAX count was rejected with sufficient budget");
+	TEST_ASSERT_EQUAL(count, UINT16_MAX,
+		"UINT16_MAX count was not returned");
+
+	TEST_ASSERT(!mlx5_rx_mcqe_count_valid(1, UINT32_C(65536), UINT16_MAX,
+						&count),
+		"uint16_t accumulated count overflow was accepted");
+	TEST_ASSERT(!mlx5_rx_mcqe_count_valid(1, 64, 65, &count),
+		"accumulated count beyond budget was accepted");
+	TEST_ASSERT(!mlx5_rx_mcqe_count_valid(1, 64, 0, NULL),
+		"NULL output pointer must be rejected");
+	return TEST_SUCCESS;
+}
+
+static int
+test_cvm_scalar_cqe_guard(void)
+{
+	enum mlx5_rx_cvm_guard_result result;
+
+	result = mlx5_rx_cvm_cqe_validate(false, true, true, UINT32_MAX,
+					  0, true, UINT8_MAX);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_OK,
+		"disabled guard changed non-CVM behavior");
+
+	result = mlx5_rx_cvm_cqe_validate(true, true, false, 64, 2048,
+					  false, 1);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_MPRQ,
+		"CVM MPRQ CQE was accepted");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, true, 64, 2048,
+					  false, 1);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_COMPRESSED,
+		"compressed CQE was accepted in CVM mode");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, false, 2049, 2048,
+					  false, 1);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_LENGTH,
+		"byte count beyond the posted buffer was accepted");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, false, 2048, 2048,
+					  false, 1);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_OK,
+		"byte count exactly filling the posted buffer was rejected");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, false, 3, 2048,
+					  true, 1);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_LENGTH,
+		"byte count shorter than the retained CRC was accepted");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, false, 4, 2048,
+					  true, 1);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_OK,
+		"minimum byte count containing the retained CRC was rejected");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, false, 64, 0,
+					  false, 1);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_LENGTH,
+		"zero posted capacity was accepted");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, false, 64, 2048,
+					  false, 2);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_LRO,
+		"LRO CQE was accepted in the scalar CVM profile");
+
+	result = mlx5_rx_cvm_cqe_validate(true, false, false, 64, 2048,
+					  false, 0);
+	TEST_ASSERT_EQUAL(result, MLX5_RX_CVM_GUARD_OK,
+		"ordinary scalar SPRQ CQE was rejected");
+	return TEST_SUCCESS;
+}
+
+static int
+test_mlx5_rx_validate(void)
+{
+	if (test_compressed_budget() != TEST_SUCCESS)
+		return TEST_FAILED;
+	if (test_compressed_count() != TEST_SUCCESS)
+		return TEST_FAILED;
+	if (test_cvm_scalar_cqe_guard() != TEST_SUCCESS)
+		return TEST_FAILED;
+	return TEST_SUCCESS;
+}
+
+REGISTER_FAST_TEST(mlx5_rx_validate_autotest, true, true,
+		   test_mlx5_rx_validate);
diff --git a/app/test/test_mlx5_tx_validate.c b/app/test/test_mlx5_tx_validate.c
new file mode 100644
index 0000000..2bb8153
--- /dev/null
+++ b/app/test/test_mlx5_tx_validate.c
@@ -0,0 +1,73 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright (c) 2026
+ */
+
+#include <stdint.h>
+
+#include "test.h"
+#include "../../drivers/net/mlx5/mlx5_tx_validate.h"
+
+static int
+test_fcq_encoding(void)
+{
+	uint32_t entry;
+
+	entry = mlx5_tx_fcq_make(UINT16_C(0x1234), UINT16_C(0xabcd));
+	TEST_ASSERT_EQUAL(mlx5_tx_fcq_elts_head(entry), UINT16_C(0x1234),
+		"elts head changed while packing FCQ entry");
+	TEST_ASSERT_EQUAL(mlx5_tx_fcq_wqe_counter(entry), UINT16_C(0xabcd),
+		"WQE counter changed while packing FCQ entry");
+
+	entry = mlx5_tx_fcq_make(UINT16_MAX, UINT16_MAX);
+	TEST_ASSERT_EQUAL(mlx5_tx_fcq_elts_head(entry), UINT16_MAX,
+		"maximum elts head did not round-trip");
+	TEST_ASSERT_EQUAL(mlx5_tx_fcq_wqe_counter(entry), UINT16_MAX,
+		"maximum WQE counter did not round-trip");
+	return TEST_SUCCESS;
+}
+
+static int
+test_cvm_tx_cqe_guard(void)
+{
+	const uint32_t entry = mlx5_tx_fcq_make(17, UINT16_C(0xfffe));
+	enum mlx5_tx_cvm_guard_result result;
+
+	result = mlx5_tx_cvm_cqe_validate(false, 7, 7, entry, 0);
+	TEST_ASSERT_EQUAL(result, MLX5_TX_CVM_GUARD_OK,
+		"disabled guard changed non-CVM behavior");
+
+	result = mlx5_tx_cvm_cqe_validate(true, 7, 7, entry,
+					  UINT16_C(0xfffe));
+	TEST_ASSERT_EQUAL(result, MLX5_TX_CVM_GUARD_NO_REQUEST,
+		"CQE without a software completion request was accepted");
+
+	result = mlx5_tx_cvm_cqe_validate(true, 7, 8, entry,
+					  UINT16_C(0xffff));
+	TEST_ASSERT_EQUAL(result, MLX5_TX_CVM_GUARD_WQE_COUNTER,
+		"unexpected WQE counter was accepted");
+
+	result = mlx5_tx_cvm_cqe_validate(true, 7, 8, entry,
+					  UINT16_C(0xfffe));
+	TEST_ASSERT_EQUAL(result, MLX5_TX_CVM_GUARD_OK,
+		"exact software-recorded WQE counter was rejected");
+
+	/* cq_pi/cq_ci are rolling uint16_t counters; inequality is sufficient. */
+	result = mlx5_tx_cvm_cqe_validate(true, UINT16_MAX, 0, entry,
+					  UINT16_C(0xfffe));
+	TEST_ASSERT_EQUAL(result, MLX5_TX_CVM_GUARD_OK,
+		"valid completion was rejected across CQ counter wrap");
+	return TEST_SUCCESS;
+}
+
+static int
+test_mlx5_tx_validate(void)
+{
+	if (test_fcq_encoding() != TEST_SUCCESS)
+		return TEST_FAILED;
+	if (test_cvm_tx_cqe_guard() != TEST_SUCCESS)
+		return TEST_FAILED;
+	return TEST_SUCCESS;
+}
+
+REGISTER_FAST_TEST(mlx5_tx_validate_autotest, true, true,
+		   test_mlx5_tx_validate);
diff --git a/drivers/common/mlx5/linux/mlx5_common_os.h b/drivers/common/mlx5/linux/mlx5_common_os.h
index df5c06f..042de32 100644
