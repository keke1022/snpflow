@@ -7,6 +7,7 @@
 
 #include <stdio.h>
 #include <malloc.h>
+#include <unistd.h>
 
 #include <rte_compat.h>
 #include <rte_pci.h>
@@ -228,8 +229,10 @@ mlx5_os_umem_reg(void *ctx, void *addr, size_t size, uint32_t access)
 	 * 每次分配单独注册一个 umem，其起点即本次分配的地址，因此
 	 * DevX 创建命令里的 umem_offset 仍然保持 0，命令结构不变。
 	 */
-	if (mlx5_cvm_shared_lookup(addr, &fd, &offset)) {
+	if (mlx5_cvm_shared_lookup_dup(addr, &fd, &offset)) {
 		struct mlx5dv_devx_umem_in umem_in;
+		struct mlx5dv_devx_umem *umem;
+		int saved_errno;
 
 		memset(&umem_in, 0, sizeof(umem_in));
 		umem_in.addr = (void *)(uintptr_t)offset;
@@ -239,7 +242,11 @@ mlx5_os_umem_reg(void *ctx, void *addr, size_t size, uint32_t access)
 		umem_in.pgsz_bitmap = ~0ULL;
 		umem_in.comp_mask = MLX5DV_UMEM_MASK_DMABUF;
 		umem_in.dmabuf_fd = fd;
-		return mlx5_glue->devx_umem_reg_ex(ctx, &umem_in);
+		umem = mlx5_glue->devx_umem_reg_ex(ctx, &umem_in);
+		saved_errno = errno;
+		close(fd);
+		errno = saved_errno;
+		return umem;
 	}
 	return mlx5_glue->devx_umem_reg(ctx, addr, size, access);
 }
diff --git a/drivers/common/mlx5/linux/mlx5_common_verbs.c b/drivers/common/mlx5/linux/mlx5_common_verbs.c
index f9e5b61..2ab71b4 100644
--- a/drivers/common/mlx5/linux/mlx5_common_verbs.c
+++ b/drivers/common/mlx5/linux/mlx5_common_verbs.c
@@ -185,7 +185,9 @@ mlx5_common_devx_reg_mr_dmabuf(void *pd, void *addr, size_t length,
 	void *devx_ctx;
 	uint32_t pdn;
 	size_t offset = 0;
+	size_t page_size;
 	int fd = -1;
+	int saved_errno;
 
 	/*
 	 * reg_mr 回调只传入 pd，拿不到 pdn。Linux 上 pd 是 struct ibv_pd，
@@ -203,7 +205,13 @@ mlx5_common_devx_reg_mr_dmabuf(void *pd, void *addr, size_t length,
 	pdn = dv_pd.pdn;
 	devx_ctx = ibv_pd->context;
 
-	if (!mlx5_cvm_shared_lookup(addr, &fd, &offset)) {
+	page_size = rte_mem_page_size();
+	if (page_size == (size_t)-1) {
+		DRV_LOG(ERR, "无法取得 mkey 页大小");
+		return -1;
+	}
+
+	if (!mlx5_cvm_shared_lookup_dup(addr, &fd, &offset)) {
 		DRV_LOG(ERR,
 			"地址 %p 不在任何 cvm_shared 区域内，无法以 dma-buf 注册",
 			addr);
@@ -217,14 +225,22 @@ mlx5_common_devx_reg_mr_dmabuf(void *pd, void *addr, size_t length,
 			 (haswell_broadwell_cpu ? 0 :
 			  IBV_ACCESS_RELAXED_ORDERING);
 	/*
-	 * pgsz_bitmap 必须非 0。置 0 时 rdma-core 返回 EINVAL，
-	 * 极易被误判成「不支持 dma-buf」。
+	 * mkey 创建路径用 rte_mem_page_size() 填 log_page_size。这里若允许
+	 * 任意页大小，内核会按长度与 DMA 对齐选择更大的 UMEM 页；例如
+	 * 长度可被 8 KiB 整除时会选择 8 KiB，而 mkey 仍声明 4 KiB，固件
+	 * 会拒绝 CREATE_MKEY。只允许与 mkey 相同的页大小，保持两者一致。
+	 *
+	 * pgsz_bitmap 的每个置位代表一个可选页大小，因此 page_size 本身
+	 * 就是仅允许该页大小的位图（页大小必须为 2 的幂）。
 	 */
-	umem_in.pgsz_bitmap = ~0ULL;
+	umem_in.pgsz_bitmap = page_size;
 	umem_in.comp_mask = MLX5DV_UMEM_MASK_DMABUF;
 	umem_in.dmabuf_fd = fd;
 
 	umem = mlx5_glue->devx_umem_reg_ex(devx_ctx, &umem_in);
+	saved_errno = errno;
+	close(fd);
+	errno = saved_errno;
 	if (umem == NULL) {
 		DRV_LOG(ERR, "devx_umem_reg_ex 失败 (addr=%p len=%zu fd=%d): %s",
 			addr, length, fd, strerror(errno));
diff --git a/drivers/common/mlx5/linux/mlx5_cvm_shared.c b/drivers/common/mlx5/linux/mlx5_cvm_shared.c
index 4f34cd6..c887040 100644
--- a/drivers/common/mlx5/linux/mlx5_cvm_shared.c
+++ b/drivers/common/mlx5/linux/mlx5_cvm_shared.c
@@ -65,8 +65,20 @@ struct cvm_chunk {
 	struct cvm_chunk *next;
 };
 
