index 0000000..4b3433d
--- /dev/null
+++ b/drivers/net/mlx5/mlx5_rx_validate.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: BSD-3-Clause
+ * Copyright (c) 2026
+ */
+
+#ifndef MLX5_RX_VALIDATE_H
+#define MLX5_RX_VALIDATE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/**
+ * Calculate the contiguous budget available to a compressed CQE session.
+ *
+ * All arguments describe state at the entry to the current vector batch,
+ * before @p consumed entries are applied. Keeping this convention in one
+ * helper prevents callers from subtracting the same entries twice.
+ * Calculations remain 32-bit until after the minimum is selected, so a large
+ * MPRQ ring cannot wrap through an early uint16_t conversion.
+ *
+ * This helper only validates arithmetic. It does not consume a CQE or define
+ * recovery from a malformed compressed session.
+ *
+ * @param cq_entries
+ *   Total number of CQ entries in the contiguous array.
+ * @param cq_offset
+ *   Entry offset of the current vector batch.
+ * @param elts_entries
+ *   Total number of software element entries in the contiguous array.
+ * @param elts_offset
+ *   Element offset of the current vector batch.
+ * @param posted_available
+ *   Number of posted buffers available at batch entry.
+ * @param consumed
+ *   Number of non-compressed entries consumed before the compressed CQE.
+ * @param[out] budget
+ *   Minimum remaining contiguous capacity. Cleared on failure.
+ *
+ * @return
+ *   true when at least one entry remains, false for invalid or empty input.
+ */
+static inline bool
+mlx5_rx_comp_budget_calc(uint32_t cq_entries, uint32_t cq_offset,
+			 uint32_t elts_entries, uint32_t elts_offset,
+			 uint32_t posted_available, uint32_t consumed,
+			 uint32_t *budget)
+{
+	uint32_t cq_remaining;
+	uint32_t elts_remaining;
+	uint32_t min_remaining;
+
+	if (budget == NULL)
+		return false;
+	*budget = 0;
+	if (cq_offset > cq_entries || elts_offset > elts_entries)
+		return false;
+	cq_remaining = cq_entries - cq_offset;
+	elts_remaining = elts_entries - elts_offset;
+	if (consumed > cq_remaining || consumed > elts_remaining ||
+	    consumed > posted_available)
+		return false;
+	cq_remaining -= consumed;
+	elts_remaining -= consumed;
+	posted_available -= consumed;
+	min_remaining = cq_remaining < elts_remaining ?
+		cq_remaining : elts_remaining;
+	if (posted_available < min_remaining)
+		min_remaining = posted_available;
+	*budget = min_remaining;
+	return min_remaining != 0;
+}
+
+/**
+ * Validate an untrusted mini-CQE count against a fixed entry budget.
+ *
+ * The raw value and all arithmetic stay 32-bit. The function also enforces
+ * the uint16_t range of the current decompressor counters. @p count is only
+ * written on success.
+ */
+static inline bool
+mlx5_rx_mcqe_count_valid(uint32_t raw, uint32_t budget,
+			 uint32_t accumulated, uint16_t *count)
+{
+	if (count == NULL || raw == 0 || raw > UINT16_MAX)
+		return false;
+	if (accumulated > budget || raw > budget - accumulated)
+		return false;
+	if (accumulated > UINT16_MAX ||
+	    raw > (uint32_t)UINT16_MAX - accumulated)
+		return false;
+	*count = (uint16_t)raw;
+	return true;
+}
+
+enum mlx5_rx_cvm_guard_result {
+	MLX5_RX_CVM_GUARD_OK = 0,
+	MLX5_RX_CVM_GUARD_MPRQ,
+	MLX5_RX_CVM_GUARD_COMPRESSED,
+	MLX5_RX_CVM_GUARD_LENGTH,
+	MLX5_RX_CVM_GUARD_LRO,
+};
+
+/**
+ * Validate the fields which can change scalar SPRQ memory access.
+ *
+ * CVM strict mode intentionally supports only scalar, single-segment SPRQ.
+ * This helper is placed before compressed-CQE decoding and before packet
+ * metadata is copied to an mbuf. Non-CVM operation is left unchanged.
+ *
+ * @param enabled
+ *   Whether CVM strict-mode validation is enabled for the queue.
+ * @param mprq
+ *   Whether the caller is the MPRQ receive function.
+ * @param compressed
+ *   Whether the CQE claims to contain compressed completions.
+ * @param byte_count
+ *   Host-provided packet byte count in CPU byte order.
+ * @param capacity
+ *   Posted data-buffer capacity for this packet.
+ * @param crc_present
+ *   Whether the byte count includes a four-byte Ethernet CRC.
+ * @param lro_num_seg
+ *   Host-provided number of LRO segments.
+ *
+ * @return
+ *   A precise rejection reason, or MLX5_RX_CVM_GUARD_OK.
+ */
+static inline enum mlx5_rx_cvm_guard_result
+mlx5_rx_cvm_cqe_validate(bool enabled, bool mprq, bool compressed,
+			 uint32_t byte_count, uint32_t capacity,
+			 bool crc_present, uint8_t lro_num_seg)
+{
+	if (!enabled)
+		return MLX5_RX_CVM_GUARD_OK;
+	if (mprq)
+		return MLX5_RX_CVM_GUARD_MPRQ;
+	if (compressed)
+		return MLX5_RX_CVM_GUARD_COMPRESSED;
+	if (capacity == 0 || byte_count > capacity ||
+	    byte_count < (crc_present ? 4U : 0U))
+		return MLX5_RX_CVM_GUARD_LENGTH;
+	if (lro_num_seg > 1)
+		return MLX5_RX_CVM_GUARD_LRO;
+	return MLX5_RX_CVM_GUARD_OK;
+}
+
+#endif /* MLX5_RX_VALIDATE_H */
