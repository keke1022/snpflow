From e05e61d76cbb560b8ebac262d1e2cff8cb209b7f Mon Sep 17 00:00:00 2001
From: keke1022 <keke83space@gmail.com>
Date: Wed, 21 Oct 2026 02:01:58 -0700
Subject: [PATCH] security: reject missing session size callback and repair
 IPsec fixture

---
 app/test/test_ipsec.c       |  9 +++++++++
 app/test/test_security.c    | 28 ++++++++++++++++++++++++++++
 lib/security/rte_security.c |  1 +
 3 files changed, 38 insertions(+)

diff --git a/app/test/test_ipsec.c b/app/test/test_ipsec.c
index ac63c3b..df6dc0d 100644
--- a/app/test/test_ipsec.c
+++ b/app/test/test_ipsec.c
@@ -179,9 +179,18 @@ dummy_sec_destroy(void *device, struct rte_security_session *sess)
 	return 0;
 }
 
+static unsigned int
+dummy_sec_get_size(void *device)
+{
+	RTE_SET_USED(device);
+	/* The dummy session has no driver-private data. */
+	return 0;
+}
+
 static const struct rte_security_ops dummy_sec_ops = {
 	.session_create = dummy_sec_create,
 	.session_destroy = dummy_sec_destroy,
+	.session_get_size = dummy_sec_get_size,
 };
 
 static struct rte_security_ctx dummy_sec_ctx = {
diff --git a/app/test/test_security.c b/app/test/test_security.c
index 23fc7ff..844d872 100644
--- a/app/test/test_security.c
+++ b/app/test/test_security.c
@@ -722,6 +722,32 @@ test_session_create_inv_context_ops_fun(void)
 	return TEST_SUCCESS;
 }
 
+/**
+ * Reject an incomplete driver before allocating a session or calling it.
+ */
+static int
+test_session_create_inv_context_ops_get_size(void)
+{
+	struct security_testsuite_params *ts_params = &testsuite_params;
+	struct security_unittest_params *ut_params = &unittest_params;
+	struct rte_security_ops ops = mock_ops;
+	void *sess;
+
+	ops.session_get_size = NULL;
+	ut_params->ctx.ops = &ops;
+	sess = rte_security_session_create(&ut_params->ctx, &ut_params->conf,
+			ts_params->session_mpool);
+	ut_params->ctx.ops = &mock_ops;
+	TEST_ASSERT_MOCK_FUNCTION_CALL_RET(rte_security_session_create,
+			sess, NULL, "%p");
+	TEST_ASSERT_MOCK_CALLS(mock_session_create_exp, 0);
+	TEST_ASSERT_MOCK_CALLS(mock_session_get_size_exp, 0);
+	TEST_ASSERT_MEMPOOL_USAGE(0);
+	TEST_ASSERT_SESSION_COUNT(0);
+
+	return TEST_SUCCESS;
+}
+
 /**
  * Test execution of rte_security_session_create with NULL conf parameter
  */
@@ -2181,6 +2207,8 @@ static struct unit_test_suite security_testsuite  = {
 				test_session_create_inv_context_ops),
 		TEST_CASE_ST(ut_setup, ut_teardown,
 				test_session_create_inv_context_ops_fun),
+		TEST_CASE_ST(ut_setup, ut_teardown,
+				test_session_create_inv_context_ops_get_size),
 		TEST_CASE_ST(ut_setup, ut_teardown,
 				test_session_create_inv_configuration),
 		TEST_CASE_ST(ut_setup, ut_teardown,
diff --git a/lib/security/rte_security.c b/lib/security/rte_security.c
index 0d89f8a..7b943f2 100644
--- a/lib/security/rte_security.c
+++ b/lib/security/rte_security.c
@@ -78,6 +78,7 @@ rte_security_session_create(void *ctx,
 	uint32_t sess_priv_size;
 
 	RTE_PTR_CHAIN3_OR_ERR_RET(instance, ops, session_create, NULL, NULL);
+	RTE_PTR_OR_ERR_RET(instance->ops->session_get_size, NULL);
 	RTE_PTR_OR_ERR_RET(conf, NULL);
 	RTE_PTR_OR_ERR_RET(mp, NULL);
 
-- 
2.51.0

